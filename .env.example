# Copy to .env for local use. On a server, set these as real environment variables
# in your host's dashboard or service file; never commit the filled-in file.

# ── Language model ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Public address of the site (no trailing slash) ──────────────────────────────
# Google sends users back to APP_BASE_URL/auth/callback, so this must match the
# address people actually visit. Use https:// in production; that also turns on
# secure cookies.
APP_BASE_URL=http://localhost:8000

# ── Google sign-in ──────────────────────────────────────────────────────────────
# Create an "OAuth client ID" of type "Web application" in Google Cloud Console:
#   APIs & Services -> OAuth consent screen (set it up once), then
#   APIs & Services -> Credentials -> Create credentials -> OAuth client ID.
# Add this exact "Authorized redirect URI" (once per address you use):
#   http://localhost:8000/auth/callback      <- local development
#   https://your-domain.com/auth/callback    <- production
# No billing is needed for sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sessions ────────────────────────────────────────────────────────────────────
# Required in production (when APP_BASE_URL is https). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_DAYS=14

# ── Database (PostgreSQL) ───────────────────────────────────────────────────────
# Paste the connection string from your Neon project: Dashboard -> Connect, with
# "Connection pooling" switched on. It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Required in production (when APP_BASE_URL is https). If left empty in local
# development the app falls back to a SQLite file, which is not for shared use.
DATABASE_URL=
# Optional: a SEPARATE database for `python -m pytest tests/test_accounts.py` (for
# example a Neon branch called "test"). Tests write fake users to it. Leave empty to
# test on a throwaway SQLite file. Must differ from DATABASE_URL.
TEST_DATABASE_URL=

# ── Daily message limits per account ────────────────────────────────────────────
DEMO_DAILY_LIMIT=3
PRO_DAILY_LIMIT=200

# ── Server ──────────────────────────────────────────────────────────────────────
# Containers and hosts usually need HOST=0.0.0.0. Many hosts set PORT themselves.
# Run a single worker: the retrievers are cached in process memory.
HOST=127.0.0.1
PORT=8000
